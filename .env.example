# Conexão com o banco legado (origem) e com o banco normalizado (destino)
LEGACY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecociente_legado
TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecociente_normalizado

# Tentativas da carga quando a conexão com o destino cai
MAX_RETRIES=3

# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
